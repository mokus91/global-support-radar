{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Global Support Radar programme record",
  "type": "object",
  "required": [
    "id",
    "title",
    "country_code",
    "category",
    "official_url",
    "source_id",
    "verification_status",
    "last_verified_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "object",
      "description": "Original title and optional translated display title."
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "enum": [
        "housing",
        "family",
        "agriculture",
        "business",
        "education",
        "healthcare",
        "energy",
        "employment",
        "social",
        "transport",
        "other"
      ]
    },
    "beneficiary_types": {
      "type": "array",
      "items": {
        "enum": [
          "individual",
          "family",
          "farmer",
          "business",
          "student",
          "employer",
          "nonprofit",
          "local_authority",
          "other"
        ]
      }
    },
    "support_type": {
      "enum": [
        "grant",
        "benefit",
        "tax_relief",
        "loan",
        "scholarship",
        "voucher",
        "service",
        "other"
      ]
    },
    "amount": {
      "type": [
        "object",
        "null"
      ]
    },
    "opening_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "ongoing": {
      "type": "boolean"
    },
    "eligibility_summary": {
      "type": [
        "object",
        "null"
      ]
    },
    "official_url": {
      "type": "string",
      "format": "uri"
    },
    "source_id": {
      "type": "string"
    },
    "source_language": {
      "type": "string"
    },
    "licence": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_status": {
      "enum": [
        "unverified",
        "official-page-checked",
        "open-and-current",
        "closed",
        "expired",
        "withdrawn"
      ]
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Az utolsó tényleges ellenőrzés időpontja, ISO 8601 időzónával."
    },
    "record_type": {
      "type": "string",
      "description": "A rekord természete; a katalógus vagy portál nem azonos egy konkrét támogatási felhívással.",
      "enum": [
        "programme",
        "call",
        "benefit",
        "portal",
        "announcement",
        "dataset-discovery",
        "directory-entry"
      ]
    },
    "application_status": {
      "type": "string",
      "description": "Jelentkezési állapot. Ismeretlen állapotot tilos nyitottként megjeleníteni.",
      "enum": [
        "open",
        "upcoming",
        "closed",
        "unknown",
        "not-applicable"
      ]
    },
    "verification_dimensions": {
      "type": "object",
      "description": "Ellenőrzési dimenziók külön-külön; egy ellenőrzött URL nem jelenti a jogosultság vagy összeg ellenőrzését.",
      "properties": {
        "official_source_checked": {
          "type": "boolean"
        },
        "application_window_checked": {
          "type": "boolean"
        },
        "eligibility_checked": {
          "type": "boolean"
        },
        "amount_checked": {
          "type": "boolean"
        },
        "latest_amendments_checked": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
